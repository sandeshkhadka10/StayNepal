<% layout("/layouts/boilerplate") %>
  <!-- <h3>All Listing</h3> -->
  <style>
    #filters{
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }
    .filter{
      text-align: center;
      margin-right: 2rem;
      margin-top: 2rem;
      opacity: 0.7;
      text-decoration: none;
    }
    .filter:hover{
      opacity: 1;
      cursor: pointer;
    }
    .filter p{
      font-size: 0.8rem;
    }
    .tax-info{
      display: none;
    }
    .tax-toggle{
      border: 1px solid black;
      border-radius: 1rem;
      height: 3.25rem;
      padding: 1rem;
      margin-left: 3rem;
      display: flex;
      align-items: center;
    }
    
  </style>
  <div id="filters">

    <a href="/listing?category=Trending" class="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </a>

    <a href="/listing?category=Room" class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Room</p>
    </a>

    <a href="/listing?category=Iconic Cities"class="filter">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </a>

    <a href="/listing?category=Mountains"class="filter">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </a>

    <a href="/listing?category=Castles"class="filter">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
    </a>

    <a href="/listing?category=Amazing Pools"class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing Pools</p>
    </a>

    <a href="/listing?category=Camping"class="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </a>

    <a href="/listing?category=Farms"class="filter">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
    </a>

    <a href="/listing?category=Artic"class="filter">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Artic</p>
    </a>

    <a href="/listing?category=Igloo"class="filter">
      <div><i class="fa-solid fa-igloo"></i></div>
      <p>Domes</p>
    </a>

    <a href="/listing?category=Sail-Boat"class="filter">
      <div><i class="fa-solid fa-sailboat"></i></div>
      <p>Sail-Boat</p>
    </a>

    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display Total After Taxes</label>
      </div>
    </div>
    
  </div>

  

  <div class="row row-cols-lg-3 row-cols-md-1 row-cols-sm-1 row-cols-1 mt-3">
    <% for(let listing of allListing){%>
      <a href="/listing/<%= listing._id %>" class="listing-link">
        <div class="card listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="Location Photo" style="height: 20rem;">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b>
                <%= listing.title %>
              </b><br>
              &#8360; <%= listing.price.toLocaleString("ne-NP")%>/ night
              <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
            </p>
          </div>
        </div>
        <br>
      </a>
      <%}%>
  </div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
   let taxInfo = document.getElementsByClassName("tax-info");
   for(info of taxInfo){
    if(info.style.display != "inline"){
      info.style.display = "inline"
    }else{
      info.style.display = "none";
    }
   }
  });
</script>