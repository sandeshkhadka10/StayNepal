<link rel="stylesheet" href="/css/index.css">

<% layout("/layouts/boilerplate") %>

  <!-- <h3>All Listing</h3> -->

  <div id="filter-wrapper">
    <button class="scroll-btn scroll-left" onclick="scrollLeftFunc()" id="leftArrow">&lt;</button>

    <div id="filters">
      
      <a href="/listing?category=Airport" class="filter">
        <div><i class="fa-solid fa-plane"></i></div>
        <p>Airport</p>
      </a>

      <a href="/listing?category=Budget" class="filter">
        <div><i class="fa-solid fa-building"></i></div>
        <p>Budget</p>
      </a>

      <a href="/listing?category=Bus-Park" class="filter">
        <div><i class="fa-solid fa-bus-simple"></i></div>
        <p>Bus-Park</p>
      </a>

      <a href="/listing?category=Camping" class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </a>

      <a href="/listing?category=City-Area" class="filter">
        <div><i class="fa-solid fa-hotel"></i></div>
        <p>City-Area</p>
      </a>

      <a href="/listing?category=Domes" class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
      </a>

      <a href="/listing?category=Eco-Friendly" class="filter">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Eco-Friendly</p>
      </a>

      <a href="/listing?category=Farms" class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </a>

      <a href="/listing?category=Home-Stay" class="filter">
        <div><i class="fa-solid fa-house"></i></div>
        <p>Home-Stay</p>
      </a>

      <a href="/listing?category=Lakes" class="filter">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Lakes</p>
      </a>

      <a href="/listing?category=Luxury" class="filter">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Luxury</p>
      </a>

      <a href="/listing?category=Mountains" class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Mountains</p>
      </a>

      <a href="/listing?category=River-Side" class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>River-Side</p>
      </a>

    </div>

    <!-- Tax Toggle: Separate from scrollable part but aligned in same row -->
    <!-- <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display Total After Taxes</label>
      </div>
    </div> -->

    <button class="scroll-btn scroll-right" onclick="scrollRightFunc()" id="rightArrow">&gt;</button>
  </div>

  <div class="row row-cols-xxl-3 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-1 mt-3">
    <% for(let listing of allListing){%>
      <a href="/listing/<%= listing._id %>" class="listing-link">
        <div class="card listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="Location Photo" style="height: 20rem;">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b>
                <%= listing.title %>
              </b>
              <br>
              <%= listing.location %>
              <br>
              &#8360; <%= listing.price.toLocaleString("ne-NP")%>/ night
                <!-- <i class="tax-info">&nbsp; &nbsp;+18% GST</i> -->
            </p>
          </div>
        </div>
        <br>
      </a>
      <%}%>
  </div>

  <script src="/js/category.js"></script>