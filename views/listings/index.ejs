<% layout("/layouts/boilerplate") %>
<body>
    <h3>All Listing</h3>

    <!-- <form method="get" action="/listing/new">
        <button>Create a new listing</button>
    </form> -->

    <% for(let listing of allListing){%>
    <div class="card" style="width: 20rem;">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="Location Photo">
        <div class="card-body">
          <p class="card-text">
            <%= listing.title %><br>
            &#8360; <%= listing.price.toLocaleString("ne-NP")%>/ night
          </p>
        </div>
      </div>
      <%}%>

    <ul>
        <% for(let listing of allListing){%>
            <li><a href="/listing/<%= listing._id %>"><%= listing.title %></a></li>
        <%}%>
    </ul>  
</body>