<% layout("/layouts/boilerplate") %>
<body>
    <h3>All Listing</h3>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-1">
        <% for(let listing of allListing){%>
            <div class="card" style="width: 20rem;">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="Location Photo">
                <div class="card-body">
                  <p class="card-text">
                    <%= listing.title %><br>
                    &#8360; <%= listing.price.toLocaleString("ne-NP")%>/ night
                  </p>
                </div>
              </div>
              <%}%>
    </div>
    
</body>