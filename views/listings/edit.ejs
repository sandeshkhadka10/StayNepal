<% layout("/layouts/boilerplate") %>
<body>
        <form method="post" action="/listing/<%= editListing.id %>?_method=PATCH">

            <div class="row">
                <div class="mb-3">
                    <h3>Edit the existing listing</h3>
                </div>
    
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" value="<%= editListing.title %>" class="form-control">
                </div>
    
                <div class="mb-3">
                    <label for="description" class="form-label"></label>
                    <textarea name="listing[description]" class="form-control"><%= editListing.description %></textarea>
                </div>
    
                <div class="mb-3">
                    <label class="image" class="form-label">Image</label>
                    <input name="listing[image]" value="<%= editListing.image %>" class="form-control">
                </div>
    
                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" value="<%= editListing.price %>" class="form-control">
                </div>
    
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" name="listing[location]" value="<%= editListing.location %>" class="form-control">
                </div>
    
                <div class="mb-3">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" value="<%= editListing.country %>" class="form-control">
                </div>
    
                <div class="mb-3">
                    <button class="btn btn-dark">Edit</button>
                </div>

            </div>
            
    </div>


</body>

