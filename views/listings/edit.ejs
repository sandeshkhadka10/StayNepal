<% layout("/layouts/boilerplate") %>
    <form method="post" action="/listing/<%= editListing.id %>?_method=PATCH" class="needs-validation" novalidate
        enctype="multipart/form-data">

        <div class="row">

            <div class="col-8 offset-2">

                <div>
                    <h3>Edit the existing listing</h3>
                </div>

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" value="<%= editListing.title %>" class="form-control"
                        id="title" required>
                    <div class="valid-feedback">Title Looks Good</div>
                    <div class="invalid-feedback">Please Fill Up Title</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" id="description"
                        required><%= editListing.description %></textarea>
                    <div class="valid-feedback">Description Looks Good</div>
                    <div class="invalid-feedback">Please Fill Up description</div>
                </div>

                <div class="mb-3">
                    Original Listing Image <br>
                    <img src="<%= originalImageUrl %>">
                </div>

                <div class="mb-3">
                    <label class="image" class="form-label" for="image">Upload New Image</label>
                    <input name="listing[image]" class="form-control" type="file" id="image">
                </div>

                <div class="row">

                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" name="listing[price]" value="<%= editListing.price %>" class="form-control" min="0"
                            id="price" required>
                        <div class="valid-feedback">Valid Amount</div>
                        <div class="invalid-feedback">Please Fill Up Valid Price</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="listing[location]" value="<%= editListing.location %>"
                            class="form-control" id="location" required>
                        <div class="valid-feedback">Valid Location</div>
                        <div class="invalid-feedback">Please Fill Up Location</div>
                    </div>

                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" name="listing[country]" value="<%= editListing.country %>" class="form-control" id="country"
                            required>
                        <div class="valid-feedback">Valid Country</div>
                        <div class="invalid-feedback">Please Fill Up Country</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="contact" class="form-label">Contact Detail:</label>
                        <input type="tel" name="listing[contact]" value="<%= editListing.contact %>" class="form-control" pattern="^(98|97)[0-9]{8}$"
                           id="contact" required>
                        <div class="valid-feedback">Valid Contact-Number</div>
                        <div class="invalid-feedback">Please Fill Up Contact-Number </div>
                    </div>

                </div>
                

                <div class="mb-3">
                    <label class="form-label" for="category">Category</label>
                    <select class="form-select" name="listing[category]" id="category" required>
                        <option selected><%= editListing.category %></option>
                        <option value="Airport">Airport</option>
                        <option value="Budget">Budget</option>
                        <option value="Bus-Park">Bus-Park</option>
                        <option value="Camping">Camping</option>
                        <option value="City-Area">City-Area</option>
                        <option value="Domes">Domes</option>
                        <option value="Eco-Friendly">Eco-Friendly</option>
                        <option value="Farms">Farms</option>
                        <option value="Home-Stay">Home-Stay</option>
                        <option value="Lakes">Lakes</option>
                        <option value="Luxury">Luxury</option>
                        <option value="Mountains">Mountains</option>
                        <option value="River-Side">River-Side</option>
                    </select>
                    <div class="valid-feedback">Valid Country</div>
                    <div class="invalid-feedback">Please Fill Up Country</div> 
                </div>

                <div class="mb-3">
                    <button class="btn btn-dark edit-btn">Edit</button>
                </div>

            </div>


        </div>