<% layout("/layouts/boilerplate") %>
    <form method="post" action="/listing" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="row">
            <div class="col-8 offset-2">
                <div>
                    <h3>Create a new listing</h3>
                </div>
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-control"
                        required>
                    <div class="valid-feedback">Title Looks Good</div>
                    <div class="invalid-feedback">Please Fill Up Title</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="enter description" class="form-control"
                        required></textarea>
                    <div class="valid-feedback">Description Looks Good</div>
                    <div class="invalid-feedback">Please Fill Up description</div>
                </div>

                <!-- <div class="mb-3">
                        <label for="image" class="form-label">Image Link</label>
                        <input name="listing[image]" placeholder="enter image url link" class="form-control" type="text">
                    </div> -->

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Listing Image</label>
                    <input name="listing[image]" class="form-control" type="file" required>
                    <div class="valid-feedback">Valid Image URL</div>
                    <div class="invalid-feedback">Please Fill Up Image URL</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="text" name="listing[price]" placeholder="1200" class="form-control" required>
                        <div class="valid-feedback">Valid Amount</div>
                        <div class="invalid-feedback">Please Fill Up Price</div>

                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="listing[location]" placeholder="Kathmandu" class="form-control"
                            required>
                        <div class="valid-feedback">Valid Location</div>
                        <div class="invalid-feedback">Please Fill Up Location</div>
                    </div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" name="listing[country]" placeholder="Nepal" class="form-control"
                            required>
                        <div class="valid-feedback">Valid Country</div>
                        <div class="invalid-feedback">Please Fill Up Country</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="contact" class="form-label">Contact Detail:</label>
                        <input type="phonenumber" name="listing[contact]" placeholder="9865983210" class="form-control"
                            required>
                        <div class="valid-feedback">Valid Contact-Number</div>
                        <div class="invalid-feedback">Please Fill Up Contact-Number </div>
                    </div>

                </div>
                

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select class="form-select form-control" name="listing[category]" required>
                        <option value="" disabled selected>Open this to select the category</option>
                        <option value="Airport">Airport</option>
                        <option value="Budget">Budget</option>
                        <option value="Bus-Park">Bus-Park</option>
                        <option value="Camping">Camping</option>
                        <option value="City-Area">City-Area</option>
                        <option value="Domes">Domes</option>
                        <option value="Eco-Friendly">Eco-Friendly</option>
                        <option value="Farms">Farms</option>
                        <option value="Home-Stay">Home-Stay</option>
                        <option value="Lakes">Lakes</option>
                        <option value="Luxury">Luxury</option>
                        <option value="Mountains">Mountains</option>
                        <option value="River-Side">River-Side</option>
                    </select>
                    <div class="valid-feedback">Valid Category</div>
                    <div class="invalid-feedback">Please Fill Up Category</div>
                </div>


                <div class="mb-3">
                    <button class="btn btn-dark add-btn">Add</button>
                </div>

            </div>
        </div>


    </form>