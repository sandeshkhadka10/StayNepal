<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">

            <div class="col-8 offset-3 mt-3 show-card">
                <h3><b><%= Listing.title %></b></h3>
            </div>

            <div class="card col-6 offset-3 mt-3 listing-card">
                <img src="<%= Listing.image.url%>" class="card-img-top" alt="listing image" id="show-img">
                <div class="card-body">
                    <p class="card-text">Owned by:
                        <i><%= Listing.owner.username %></i>
                    </p>

                    <p class="card-text">
                        <%= Listing.description %>
                    </p>

                    <p class="card-text">
                        &#8360; <%= Listing.price.toLocaleString("ne-NP") %>
                    </p>

                    <p class="card-text">
                        <%= Listing.location %>
                    </p>

                    <p class="card-text">
                        <%= Listing.country %>
                    </p>

                </div>
            </div>

            

            <% if(currUser && currUser._id.equals(Listing.owner._id)){ %>
                <div class="btns">
                    <a href="/listing/<%= Listing.id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn mt-3">Edit</a>
    
                    <form method="post" action="/listing/<%= Listing.id %>?_method=DELETE">
                        <button class="btn btn-dark offset-2 mt-3">Delete</button>
                    </form>
                    
                </div>

            <%}%>
            

            <!-- For Review Form -->
             <div class="col-8 offset-3 mb-3">
                <% if(currUser){%>
                <h4>Leave a Review</h4>
                <form method="post" action="/listing/<%= Listing.id %>/reviews" class="needs-validation" novalidate>
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                    </div>

                    <fieldset class="starability-slot">
                        <legend>First rating:</legend>
                        <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="rating" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="rating" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="rating" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="rating" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="rating" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>

                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[comment]" rows="5" cols="30" id="comment" class="form-control" required></textarea>
                        <div class="valid-feedback">Comment Added</div>
                        <div class="invalid-feedback">Please Fill Up Comment</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
                <%}%>

                <hr>

                <p><b>All Reviews</b></p>
                <div class="row">
                    <% for(review of Listing.reviews){ %>
                        <div class="card col-5 ms-3 mb-3">
                            <div class="card-body">
                                <h5 class="card-title"><%= review.author.username%></h5>
                                <p class="card-text"><%= review.comment %></p>
                                <p class="card-text"><%= review.rating %>stars</p>
                              </div>
                              <form class="mb-3" method="post" action="/listing/<%= Listing.id %>/reviews/<%= review.id %>?_method=DELETE">
                                <button class="btn btn-sm btn-dark">Delete</button>
                              </form>
                        </div>
                    <%}%>
                </div>
                
                

             </div>

        </div>

    </body>