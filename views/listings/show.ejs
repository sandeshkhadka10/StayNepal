<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">

            <div class="col-8 offset-3 mt-3 show-card">
                <h3><b><%= Listing.title %></b></h3>
            </div>

            <div class="card col-6 offset-3 mt-3">
                <img src="<%= Listing.image.url%>" class="card-img-top" alt="listing image" id="show-img">
                <div class="card-body">
                    <p class="card-text">
                        <%= Listing.description %><br>
                        &#8360; <%= Listing.price.toLocaleString("ne-NP") %><br>
                        <%= Listing.location %><br>
                        <%= Listing.country %>

                    </p>
                </div>
            </div>

            <div class="btns">
                <a href="/listing/<%= Listing.id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn mt-3">Edit</a>

                <form method="post" action="/listing/<%= Listing.id %>?_method=DELETE">
                    <button class="btn btn-dark offset-2 mt-3">Delete</button>
                </form>
                
            </div>

            <!-- For Review Form -->
             <div class="col-8 offset-3 mb-3">
                <hr>
                <h4>Leave a Review</h4>
                <form method="post" action="/listing/<%= Listing.id %>/reviews" class="needs-validation" novalidate>
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[comment]" rows="5" cols="30" id="comment" class="form-control" required></textarea>
                        <div class="valid-feedback">Comment Added</div>
                        <div class="invalid-feedback">Please Fill Up Comment</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>

             </div>

        </div>

    </body>