<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">

            <div class="col-8 offset-3 mt-3 show-card">
                <h3><b><%= Listing.title %></b></h3>
            </div>

            <div class="card col-6 offset-3 mt-3">
                <img src="<%= Listing.image.url%>" class="card-img-top" alt="listing image" id="show-img">
                <div class="card-body">
                    <p class="card-text">
                        <%= Listing.description %><br>
                        &#8360; <%= Listing.price.toLocaleString("ne-NP") %><br>
                        <%= Listing.location %><br>
                        <%= Listing.country %>

                    </p>
                </div>
            </div>

            <div class="btns">
                <a href="/listing/<%= Listing.id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn mt-3">Edit</a>

                <form method="post" action="/listing/<%= Listing.id %>?_method=DELETE">
                    <button class="btn btn-dark offset-2 mt-3">Delete</button>
                </form>
                
            </div>

            <!-- For Review Form -->
             <div class="col-8 offset-3">
                <h4>Leave a Review</h4>
                <form>
                    <div>
                        <label for="rating">Rating</label>
                        <input type="range" min="1" max="5" id="rating" name="review[rating]">
                    </div>
                    <div>
                        <label for="comment">Comments</label>
                        <textarea name="review[comment]" rows="10" cols="30" id="comment"></textarea>
                    </div>
                    <button>Submit</button>
                </form>

             </div>

        </div>

    </body>