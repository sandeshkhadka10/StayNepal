<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">

            <div class="col-8 offset-2 mt-3">
                <h3>Listing Details</h3>
            </div>

            <div class="card col-6 offset-2 mt-3">
                <img src="<%= Listing.image.url%>" class="card-img-top" alt="listing image" id="show-img">
                <div class="card-body">
                    <p class="card-text">
                        <b><%= Listing.title %></b><br>
                        <%= Listing.description %><br>
                        &#8360; <%= Listing.price.toLocaleString("ne-NP") %><br>
                        <%= Listing.location %><br>
                        <%= Listing.country %>

                    </p>
                </div>
            </div>



        </div>

        <a href="/listing/<%= Listing.id %>/edit">Edit this Listing</a>
        <br><br>
        <form method="post" action="/listing/<%= Listing.id %>?_method=DELETE">
            <button>Delete</button>
        </form>
    </body>