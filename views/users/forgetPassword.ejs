<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <h1 class="col-6 offset-5">Search</h1>
    <div class="col-6 offset-3">
        <form method="post" action="/forgetPassword" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="email" class="label-form">Enter your registered email address</label>
                <input type="text" name="email" class="form-control" id="email" required>
                <div class="valid-feedback">Email Entered</div>
                <div class="invalid-feedback">Please Fill Up Email</div>
            </div>

            <div class="text-center">
                <button class="btn btn-success">Submit</button>
            </div>
            
        </form>
    </div>
</div>