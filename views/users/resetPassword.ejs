<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <h1 class="col-6 offset-5">Reset</h1>
    <div class="col-6 offset-3">
        <form method="post" action="/resetPassword" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="newPassword" class="label-form">New Password</label>
                <input type="password" name="newPassword" class="form-control" id="newPassword" required>
                <div class="valid-feedback">Password Entered</div>
                <div class="invalid-feedback">Please Fill Up Password</div>
            </div>

            <div class="text-center">
                <button class="btn btn-success">Reset Password</button>
            </div>
            
        </form>
    </div>
</div>