<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <h1 class="col-6 offset-5">Booking Form</h1>
        <div class="col-6 offset-3">
            <form method="post" action="/listing/<%= Listing._id %>/book" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="name" class="label-form">Full Name</label>
                    <input type="text" name="booking[name]" class="form-control" id="name" required>
                    <div class="valid-feedback">Name Entered</div>
                    <div class="invalid-feedback">Please Fill Up Name</div>
                </div>

                <div class="mb-3">
                    <label for="email">Your Email</label>
                    <input type="email" class="form-control" name="booking[email]" required>
                    <div class="valid-feedback">Email Entered</div>
                    <div class="invalid-feedback">Please Fill Up Email</div>
                </div>

                <div class="mb-3">
                    <label for="phone">Phone Number</label>
                    <input type="text" class="form-control" name="booking[contact]" pattern="^(98|97)[0-9]{8}$" required>
                    <div class="valid-feedback">Name Entered</div>
                    <div class="invalid-feedback">Please Fill Up Name</div>
                </div>

                <div class="mb-3">
                    <label for="checkin">Check-in Date</label>
                    <input type="date" class="form-control" name="booking[checkin]" required>
                    <div class="valid-feedback">Check-in Date Entered</div>
                    <div class="invalid-feedback">Please Fill Up Check-in Date</div>
                </div>

                <div class="mb-3">
                    <label for="checkout">Check-out Date</label>
                    <input type="date" class="form-control" name="booking[checkout]" required>
                    <div class="valid-feedback">Check-out Date Entered</div>
                    <div class="invalid-feedback">Please Fill Up Check-out Date</div>
                </div>

                <div class="text-center">
                    <button class="btn btn-success">Confirm Booking</button>
                </div>

            </form>
        </div>
    </div>